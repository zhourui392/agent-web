{
  "contractVersion": "1.0.0",
  "stageOrder": [
    "ANALYSIS",
    "DESIGN",
    "IMPLEMENTATION",
    "DEPLOYMENT"
  ],
  "stages": [
    {
      "stage": "ANALYSIS",
      "promptPack": "analysis@1.0.0",
      "requiredInputArtifacts": [
        "ORIGINAL_REQUIREMENT"
      ],
      "defaultSkills": [
        "requirement-analysis@1.0.0"
      ],
      "mcpCapabilities": [
        "requirement.read",
        "documentation.read"
      ],
      "filesystem": {
        "workspace": "READ",
        "artifactStore": "WRITE",
        "other": "DENY"
      },
      "commands": [
        "repository.search",
        "git.status",
        "git.log",
        "git.diff.read"
      ],
      "requiredOutputArtifacts": [
        "REQUIREMENT",
        "ACCEPTANCE_CRITERIA",
        "IMPACT_ANALYSIS",
        "OPEN_QUESTIONS"
      ],
      "deterministicGates": [
        "required-artifacts-present",
        "artifact-schema-valid",
        "requirement-ids-unique",
        "acceptance-criteria-observable",
        "no-blocking-open-question"
      ],
      "approval": "REQUIREMENT_BASELINE"
    },
    {
      "stage": "DESIGN",
      "promptPack": "design@1.0.0",
      "requiredInputArtifacts": [
        "REQUIREMENT",
        "ACCEPTANCE_CRITERIA",
        "IMPACT_ANALYSIS"
      ],
      "defaultSkills": [
        "java-ddd-design@1.0.0",
        "test-strategy@1.0.0"
      ],
      "mcpCapabilities": [
        "documentation.read"
      ],
      "filesystem": {
        "workspace": "READ",
        "artifactStore": "WRITE",
        "other": "DENY"
      },
      "commands": [
        "repository.search",
        "git.status",
        "git.diff.read"
      ],
      "requiredOutputArtifacts": [
        "SOLUTION",
        "CHANGE_PLAN",
        "TEST_STRATEGY",
        "DEPLOYMENT_PLAN",
        "ROLLBACK_PLAN",
        "TRACEABILITY"
      ],
      "deterministicGates": [
        "required-artifacts-present",
        "artifact-schema-valid",
        "requirement-design-coverage-complete",
        "requirement-test-coverage-complete",
        "layering-decision-present",
        "rollback-plan-present"
      ],
      "approval": "DESIGN_BASELINE"
    },
    {
      "stage": "IMPLEMENTATION",
      "promptPack": "implementation@1.0.0",
      "requiredInputArtifacts": [
        "REQUIREMENT",
        "ACCEPTANCE_CRITERIA",
        "SOLUTION",
        "CHANGE_PLAN",
        "TEST_STRATEGY"
      ],
      "defaultSkills": [
        "java-tdd@1.0.0"
      ],
      "mcpCapabilities": [
        "documentation.read"
      ],
      "filesystem": {
        "workspace": "WRITE",
        "artifactStore": "WRITE",
        "other": "DENY"
      },
      "commands": [
        "repository.search",
        "git.status",
        "git.diff.read",
        "test.focused",
        "quality.focused"
      ],
      "requiredOutputArtifacts": [
        "CHANGED_FILES",
        "TEST_EVIDENCE",
        "IMPLEMENTATION_SUMMARY",
        "TRACEABILITY"
      ],
      "deterministicGates": [
        "required-artifacts-present",
        "artifact-schema-valid",
        "git-baseline-unchanged-or-explained",
        "tdd-evidence-present-for-business-branches",
        "focused-tests-passed",
        "traceability-complete",
        "no-sensitive-file-change"
      ],
      "approval": "DEPLOYABLE_BASELINE"
    },
    {
      "stage": "DEPLOYMENT",
      "promptPack": "deployment@1.0.0",
      "requiredInputArtifacts": [
        "ACCEPTANCE_CRITERIA",
        "DEPLOYMENT_PLAN",
        "ROLLBACK_PLAN",
        "CHANGED_FILES",
        "TEST_EVIDENCE",
        "TRACEABILITY"
      ],
      "defaultSkills": [
        "agent-web-local-deployment@1.0.0"
      ],
      "mcpCapabilities": [],
      "filesystem": {
        "workspace": "READ",
        "artifactStore": "WRITE",
        "other": "DENY"
      },
      "commands": [
        "build.local",
        "deploy.local",
        "health.local",
        "acceptance.local",
        "rollback.local"
      ],
      "environmentAllowlist": [
        "local"
      ],
      "requiredOutputArtifacts": [
        "PREFLIGHT",
        "BUILD_EVIDENCE",
        "DEPLOYMENT_RECORD",
        "ACCEPTANCE_RESULT",
        "FINAL_REPORT"
      ],
      "deterministicGates": [
        "required-artifacts-present",
        "artifact-schema-valid",
        "approved-git-baseline-matches",
        "build-passed",
        "local-health-check-passed",
        "acceptance-criteria-passed"
      ],
      "actionApproval": "LOCAL_DEPLOY",
      "approval": "DELIVERY_COMPLETE"
    }
  ],
  "deterministicGateVerifiers": {
    "required-artifacts-present": { "verifier": "structural-existence", "note": "校验最新版本 Artifact keyset 包含合同所有 requiredOutputArtifacts，不查内容" },
    "artifact-schema-valid": { "verifier": "structural-existence", "note": "非 JSON 类型查非空；JSON 类型用 readTree 校验合法 JSON object，不按 artifact.schema.json 校验" },
    "requirement-ids-unique": { "verifier": "regex-set", "note": "正则扫 REQUIREMENT 文本的 REQ-ID，全部唯一且 count>0" },
    "acceptance-criteria-observable": { "verifier": "structural-existence", "note": "查 ACCEPTANCE_CRITERIA 每条 id/requirementId/description/verification 字段非空；不判定 verification 是否真可观测" },
    "no-blocking-open-question": { "verifier": "field-check", "note": "OPEN_QUESTIONS 存在 blocking=true 且 answered=false 即失败" },
    "requirement-design-coverage-complete": { "verifier": "structural-existence", "note": "TRACEABILITY 每行 designRef 非空；不与 REQ-ID 交叉校验覆盖完整性" },
    "requirement-test-coverage-complete": { "verifier": "structural-existence", "note": "TRACEABILITY 每行 testRef 非空；不交叉校验覆盖完整性" },
    "layering-decision-present": { "verifier": "structural-existence", "note": "SOLUTION 文本含子串 domain+application，CHANGE_PLAN.changes 每条 layer 非空；不判定真实分层" },
    "rollback-plan-present": { "verifier": "structural-existence", "note": "ROLLBACK_PLAN 文本 trim 非空，无内容校验" },
    "git-baseline-unchanged-or-explained": { "verifier": "hash-match", "note": "CHANGED_FILES 的 baselineHead==currentHead 或 baselineExplanation 非空即通过；Hash 自报，Gate 不重跑 git" },
    "tdd-evidence-present-for-business-branches": { "verifier": "evidence-structure", "note": "TEST_EVIDENCE 找 RED(exitCode!=0) 先于 GREEN(exitCode==0)；'for-business-branches' 限定未实现，不区分业务分支" },
    "focused-tests-passed": { "verifier": "exit-code", "note": "TEST_EVIDENCE 的 GREEN/VERIFY phase exitCode==0 且至少一条" },
    "traceability-complete": { "verifier": "structural-existence", "note": "TRACEABILITY 每行 requirementId/acceptanceCriteriaId/designRef/testRef/implementationRef 五字段非空；不交叉校验完整性" },
    "no-sensitive-file-change": { "verifier": "path-blacklist", "note": "CHANGED_FILES 路径命中黑名单(env.local/data/secrets.properties/.codex 等)或 sensitive=true 即失败" },
    "approved-git-baseline-matches": { "verifier": "self-reported", "note": "读 PREFLIGHT.gitBaselineMatches==true，自报布尔，Gate 不独立比对已批准基线" },
    "build-passed": { "verifier": "exit-code", "note": "BUILD_EVIDENCE.exitCode==0" },
    "local-health-check-passed": { "verifier": "self-reported", "note": "读 ACCEPTANCE_RESULT.healthPassed==true，自报布尔" },
    "acceptance-criteria-passed": { "verifier": "self-reported", "note": "ACCEPTANCE_RESULT.criteria 每条 passed==true；不与 ANALYSIS 原始 AC 交叉校验覆盖" }
  }
}
